<!DOCTYPE html>
<html lang="en">

<%# Include the shared head partial as HTML. %>
<%- include("./partials/head.ejs") %>

<body>
  <div class="page">
    
    <%# Include the shared page header. %>
    <%- include("./partials/header.ejs") %>

    <main>

      <article class="post">
          <p class="post-meta">
            <%= post.formattedDate %>
          </p>

          <p class="post-body">
            <%= post.content %>
          </p>
          <div class="post-actions">
          <%# Submit a request to delete this post. %>
          <form action="/delete/<%= post._id %>" method="POST">
            <button type="submit">Delete</button>
          </form>

            <%# Open the edit form for this post. %>
            <a href="/edit/<%= post._id %>">Edit post</a>
          </div>
      </article>

    </main>

    <%# Include the shared footer partial as HTML. %>
    <%- include("./partials/footer.ejs") %>

  </div>

</body>

</html>