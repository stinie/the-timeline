<!DOCTYPE html>
<html lang="en">

<%# Include the shared head partial as HTML. %>
<%- include("./partials/head.ejs") %>

<body>
  <div class="page">
    <header>
      <h1>Timeline</h1>
    </header>

    <main>
      
      <% if (postsError) { %>
        <article class="post error">
          <p role="alert"><%= postsError %></p>
        </article>
      <% } %>

      <% posts.forEach(post=> { %>
        <article class="post">
          <p class="post-meta">
            <%= post.authorName %> — <%= post.formattedDate %>
          </p>
          <p class="post-body">
            <%= post.content %>
          </p>
        </article>
        <% }) %>

    </main>

    <%# Include the shared footer partial as HTML. %>
    <%- include("./partials/footer.ejs") %>

  </div>

</body>

</html>