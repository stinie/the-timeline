<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="author" content="Christine Fürst">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📁</text></svg>">
  <link rel="stylesheet" href="/style.css">
  <title>Timeline</title>
</head>

<body>
  <div class="page">
    <header>
      <h1>Timeline</h1>
    </header>

    <main>

      <% posts.forEach(post => { %>
        <article class="message">
          <p class="message-meta"><%= post.authorName %> — <%= post.createdAt %></p>
          <p><%= post.message %></p>
        </article>
      <% }) %>

    </main>

    <footer>
      <p>Built with HTML, CSS, JavaScript, and Express.</p>
    </footer>
  </div>

</body>

</html>