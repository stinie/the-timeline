<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head.ejs") %>

<body>
  <div class="page">

    <%- include("../partials/header.ejs") %>

    <main>
      <article class="post error">
        <%# Show access details when provided; otherwise use a generic error. %>
        <h1><%= typeof message !== "undefined" ? title : "Something went wrong" %></h1>
        <p><%= typeof message !== "undefined" ? message : "Please try again later." %></p>
  
        <a href="/">Back to the Timeline</a>
      </article>
    </main>

    <%- include("../partials/footer.ejs") %>
  </div>
</body>

</html>
