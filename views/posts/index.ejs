<!DOCTYPE html>
<html lang="en">

<%# Include the shared head partial as HTML. %>
  <%- include("../partials/head.ejs") %>

    <body>
      <div class="page">

        <%# Include the shared page header. %>
        <%- include("../partials/header.ejs") %>

        <main>

          <article class="post">
            <p class="intro">
              Welcome to The Timeline! This is a simple message board.
            </p>
            <%# Show the post form only when a user is logged in. %>
            <% if (currentUser) { %>
            <%# Test server validation: add novalidate to the form; remove after testing. %>
            <form action="/posts" method="POST" class="post-form" aria-label="Post a message">
              <label for="content">Post a message</label>
              <%# Testing: Temporarily remove minlength="25" to test server-side validation. Restore it afterwards. %>
              <textarea name="content" id="content" rows="3" minlength="25" placeholder="What's on your mind?" required><%= typeof submittedContent !== "undefined" ? submittedContent : "" %></textarea>
              <% if (typeof validationError !== "undefined" && validationError) { %>
                <p class="error" role="alert">
                  <%= validationError %>
                </p>
              <% } %>
              <button type="submit">Post a message</button>
            </form>
            <% } %>
          </article>

          <% if (postsError) { %>
          <article class="post error">
            <p role="alert">
              <%= postsError %>
            </p>
          </article>
          <% } %>

          <% if (successMessage) { %>
            <article class="post success">
              <p role="status">
                <%= successMessage %>
              </p>
            </article>
          <% } %>

          <% posts.forEach(post=> { %>
          <article class="post timeline-post">
          <h2 class="post-meta">
            <%= post.userId ? `${post.userId.firstName} ${post.userId.lastName}` : "No Author" %>
             — 
            <%= post.formattedDate %> 
          </h2>

          <p class="post-body">
            <%# Shorten long messages on the homepage; keep the full content in MongoDB. %>
              <%= post.content.length> 250 ? post.content.slice(0, 250) + "…" : post.content %>
              <%# Link to the full post using its MongoDB ID. %>
              <a href="/posts/<%= post._id %>">See more</a>
          </p>

          <section class="comments" aria-label="Comments">
            <!-- Existing comments -->
            <% post.comments.forEach(comment => { %>
            <article class="comment">
              <h3 class="comment-meta">
                <%= comment.userId ? `${comment.userId.firstName} ${comment.userId.lastName}` : "No Author" %>
                 — 
                <%= comment.formattedDate %> 
              </h3>
              <p class="comment-body"><%= comment.content %></p>
            </article>
            <% }) %>

            <%# Show the comments form only when a user is logged in. %>
            <% if (currentUser) { %>
            <form action="/posts/<%= post._id %>/comments" method="POST" class="comment-form" aria-label="Post a comment">
              <label for="comment-<%= post._id %>">Post a comment</label>
              <%# Testing: Temporarily remove minlength="25" to test server-side validation. Restore it afterwards. %>
              <textarea name="content" id="comment-<%= post._id %>" rows="5" minlength="25" required><%= typeof submittedComment !== "undefined" && commentPostId === String(post._id) ? submittedComment : "" %></textarea>
              <% if (typeof commentValidationError !== "undefined" && commentValidationError && commentPostId === String(post._id)) { %>
                <p class="error" role="alert"><%= commentValidationError %></p>
              <% } %>
              <button type="submit">Post a comment</button>
            </form>
            <% } %>
          </section><!-- End Comments -->

          </article>
          <% }) %>

        </main>

        <%# Include the shared footer partial as HTML. %>
        <%- include("../partials/footer.ejs") %>

      </div>

    </body>

</html>
