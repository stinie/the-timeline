<!DOCTYPE html>
<html lang="en">

<%# Include the shared head partial as HTML. %>
<%- include("./partials/head.ejs") %>

<body>
  <div class="page">
    
    <%# Include the shared page header. %>
    <%- include("./partials/header.ejs") %>

    <main>
      
      <article class="post">
      <p class="post-meta">
        <%= post.formattedDate %>
      </p>

      <form action="/posts/<%= post._id %>" method="POST">
        <textarea name="content" rows="10" cols="50" minlength="25" required><%= post.content %></textarea>

        <div class="post-actions">
          <button type="submit" class="edit-post-button">Submit</button>
        </div>
      </form>
    </article>

    </main>

    <%# Include the shared footer partial as HTML. %>
    <%- include("./partials/footer.ejs") %>

  </div>

</body>

</html>